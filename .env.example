# 与 yibelin / doc2doc GeminiTranslator 同一套 Vertex 配置

# 推荐：加密服务账号 JSON（与 doc2doc .env 可共用）
# GOOGLE_CREDENTIALS_ENC=enc:v1:...
# DOC2DOC_SECRETS_KEY=your-master-passphrase

# 备用：明文服务账号路径
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# CrewAI 遥测（国内网络常超时，建议关闭）
OTEL_SDK_DISABLED=true
CREWAI_DISABLE_TELEMETRY=true

# 联网挖词：已改用 Vertex Gemini Google Search Grounding
# 不再需要 Custom Search API Key / CX（下列为历史可选项，可删）
# GOOGLE_SEARCH_CX=
# GOOGLE_CSE_API_KEY=
# GOOGLE_API_KEY=

# 可选：WordPress / GSC（publish_and_monitor.py）
# WP_USER=
# WP_APP_PASSWORD=
# WP_URL=https://yibelin.com/wp-json/wp/v2/posts
# GOOGLE_GSC_KEY_JSON=
# GSC_SITE_URL=sc-domain:yibelin.com

# GitHub Actions 专用（仅仓库 Secrets，勿提交）：
# 若 org 禁止 GITHUB_TOKEN 创建 PR，请配置 GH_PAT（classic: repo；或 fine-grained: Contents + Pull requests）
# GH_PAT=
