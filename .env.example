# 与 yibelin / doc2doc GeminiTranslator 同一套 Vertex 配置

# 推荐：加密服务账号 JSON（与 doc2doc .env 可共用）
# GOOGLE_CREDENTIALS_ENC=enc:v1:...
# DOC2DOC_SECRETS_KEY=your-master-passphrase

# 备用：明文服务账号路径
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

GOOGLE_CLOUD_PROJECT=project-204c4e56-18e3-4ca0-94c
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# CrewAI 遥测（国内网络常超时，建议关闭）
OTEL_SDK_DISABLED=true
CREWAI_DISABLE_TELEMETRY=true

# 可选：后续 Serper 搜索
# SERPER_API_KEY=

# 可选：WordPress / GSC（publish_and_monitor.py）
# WP_USER=
# WP_APP_PASSWORD=
# WP_URL=https://yibelin.com/wp-json/wp/v2/posts
# GOOGLE_GSC_KEY_JSON=
# GSC_SITE_URL=sc-domain:yibelin.com
